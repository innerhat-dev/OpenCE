/* BINDING(name, Mac default, other native default, config comment).
   Keep the config defaults and the input parser's fallback in one place. */
BINDING(move_forward, "W", "W", "Move forward. Bindings are comma-separated key names (case-insensitive).\nUse Ctrl or Shift for either side; LeftCtrl/RightCtrl for one side.\nMouseLeft, MouseRight, MouseMiddle, MouseX1, MouseX2 and Wheel also work.\nAn empty string disables an action. Edit this file with Halo closed, then restart.")
BINDING(move_back, "S", "S", "Move backward.")
BINDING(move_left, "A", "A", "Strafe left.")
BINDING(move_right, "D", "D", "Strafe right.")
BINDING(dpad_up, "Up", "Up", "Xbox D-pad up (menu navigation).")
BINDING(dpad_down, "Down", "Down", "Xbox D-pad down.")
BINDING(dpad_left, "Left", "Left", "Xbox D-pad left.")
BINDING(dpad_right, "Right", "Right", "Xbox D-pad right.")
BINDING(a, "Space, Return, KeypadEnter", "Space, Return, KeypadEnter", "Xbox A: jump / accept with the standard controller preset.")
BINDING(b, "F, Backspace, MouseX1, ACBack", "F, Backspace, MouseX1, ACBack", "Xbox B: melee / back. On Mac, Escape always pauses gameplay or goes back in menus.")
BINDING(x, "E, R", "E, R", "Xbox X: action / reload.")
BINDING(y, "Q, Tab, Wheel", "Tab, Wheel", "Xbox Y: change weapon.")
BINDING(start, "1", "Escape", "Xbox Start: pause.")
BINDING(select, "Grave, F1", "F1", "Xbox Back/Select: hold for the scoreboard. Grave is the backtick (`) key.")
BINDING(crouch, "Shift", "LeftCtrl, C", "Left-stick click: crouch.")
BINDING(zoom, "Ctrl, MouseMiddle", "Z, MouseMiddle", "Right-stick click: zoom.")
BINDING(white, "L", "Q", "Xbox white: flashlight.")
BINDING(black, "X", "X", "Xbox black: switch grenade type.")
BINDING(left_trigger, "G, MouseRight", "G, MouseRight", "Xbox left trigger: throw grenade.")
BINDING(right_trigger, "MouseLeft", "MouseLeft", "Xbox right trigger: fire.")
BINDING(console, "F2", "Grave", "Developer console toggle (keyboard keys only). This key takes priority\nover controller actions; choose a different key from Select.")
BINDING(release_mouse, "F12", "F12", "Release / recapture the mouse (keyboard keys only).")
